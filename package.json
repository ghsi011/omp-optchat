{
  "name": "@ericjuta/omp-optchat",
  "version": "0.7.0",
  "description": "An endless OMP chat backed by a durable log and binary summary memory tree, inspired by Victor Taelin's OptChat.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./opencode": "./src/opencode/index.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "files": ["src", "README.md", "CHANGELOG.md"],
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:opencode": "bun run scripts/opencode-smoke.ts",
    "evidence:recall": "bun run scripts/evidence-recall.ts",
    "evidence:retrieval": "bun run scripts/retrieval-compare.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.27",
    "@opencode/schema": "2.0.27",
    "effect": "4.0.1",
    "@oh-my-pi/pi-ai": ">=18.9.0",
    "@oh-my-pi/pi-catalog": ">=18.9.0",
    "@oh-my-pi/pi-coding-agent": ">=18.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": { "optional": true },
    "@opencode/schema": { "optional": true },
    "effect": { "optional": true },
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-catalog": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.27",
    "@opencode/client": "2.0.27",
    "@opencode/schema": "2.0.27",
    "effect": "4.0.1",
    "@oh-my-pi/pi-ai": "18.9.1",
    "@oh-my-pi/pi-catalog": "18.9.1",
    "@oh-my-pi/pi-coding-agent": "18.9.1",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
